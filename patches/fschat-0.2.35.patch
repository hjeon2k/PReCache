+def precache_reset(model):
+    """New trajectory: shared base KV cache, one LR cache per agent, and the token ids they hold."""
+    from transformers.cache_utils import DynamicCache, LRCache
+
+    model.precache = (DynamicCache(), {name: LRCache() for name in model.peft_config}, [])
