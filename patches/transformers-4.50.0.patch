+class LRCache(Cache):
+    """Per-adapter LR cache X @ A: one [batch, seq_len, rank] tensor per layer."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._seen_tokens = 0
+        self.value_cache: List[torch.Tensor] = []
+
+    def __len__(self):
+        return len(self.value_cache)
+
+    def update(self, value_states: torch.Tensor, layer_idx: int) -> torch.Tensor:
+        if layer_idx == 0:
+            self._seen_tokens += value_states.shape[-2]
+        if len(self.value_cache) <= layer_idx:
+            self.value_cache.append(value_states)
+        else:
+            self.value_cache[layer_idx] = torch.cat([self.value_cache[layer_idx], value_states], dim=-2)
+        return self.value_cache[layer_idx]
+
+    def get_seq_length(self, layer_idx: Optional[int] = 0) -> int:
+        if len(self.value_cache) <= layer_idx:
+            return 0
+        return self.value_cache[layer_idx].shape[-2]
+
+    def crop(self, max_length: int) -> None:
+        for idx in range(len(self.value_cache)):
+            self.value_cache[idx] = self.value_cache[idx][..., :max_length, :]
+        self._seen_tokens = max_length
+
